{
  "expo": {
    "name": "Lily",
    "slug": "lily",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lily",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.caiostoduto.lily"
    },
    "android": {
      "package": "com.caiostoduto.lily",
      "adaptiveIcon": {
        "backgroundColor": "#651B3D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#651B3D",
          "dark": {
            "backgroundColor": "#651B3D"
          }
        }
      ],
      [
        "@reactvision/react-viro",
        {
          "android": {
            "xRMode": "AR"
          },
          "ios": {
            "cameraUsagePermission": "Lily uses your camera to bring printed photos to life."
          }
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Lily uses your camera to scan printed photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lily uses your photos to add videos to markers."
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
